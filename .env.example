# RAG_app settings
#
# Copy this file to .env and change only what you need:
#     cp .env.example .env          (Windows: copy .env.example .env)
#
# Every setting below is optional — the values shown are the defaults the app
# uses when the setting is missing. All names use the RAG_ prefix.
# Never commit your real .env; it is git-ignored.


# --- Paths ----------------------------------------------------------------

# Where your source documents live.
RAG_DATA_DIR=./data

# Where the vector store is written. Safe to delete; rebuilt by re-ingesting.
RAG_STORE_DIR=./data/vector_store

# Name of the collection holding the embedded chunks.
RAG_COLLECTION_NAME=documents


# --- Parsing (Phase 2) ----------------------------------------------------

# Read text from images and scanned PDFs. Accurate but slow — turn off if all
# your PDFs already have a real text layer.
RAG_ENABLE_OCR=true

# Language hints for OCR, comma-separated. Example: en,de,fr
RAG_OCR_LANGUAGES=en


# --- Chunking (Phase 3) ---------------------------------------------------

# Maximum tokens per chunk. Keep at or below the embedding model's limit (512
# for the default model) or the tail of each chunk gets silently dropped.
RAG_CHUNK_MAX_TOKENS=512


# --- Embeddings (Phase 4) -------------------------------------------------

# Any model name supported by fastembed. Changing this makes existing
# embeddings unusable, so re-ingest your documents afterwards.
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5


# --- Retrieval (Phase 5) --------------------------------------------------

# How many chunks to feed the model per question. Higher = more context but
# slower and more expensive.
RAG_TOP_K=5

# Discard chunks scoring below this similarity, from 0.0 to 1.0.
# Leave at 0.0 to keep everything.
RAG_MIN_RELEVANCE=0.0


# --- Hybrid search (Phase 6) ---------------------------------------------

# Retrieval strategy: dense | hybrid | hybrid+rerank
RAG_RETRIEVAL_MODE=dense


# --- Answer generation (Phase 5) -----------------------------------------

# Which service answers questions:
#   none   - skip generation, just return the retrieved chunks (no key needed)
#   ollama - a model running locally, nothing sent off your machine
#   openai - OpenAI or any OpenAI-compatible hosted API
RAG_LLM_PROVIDER=none

# Model name as your provider spells it.
# openai example: gpt-4o-mini      ollama example: llama3.1
RAG_LLM_MODEL=gpt-4o-mini

# API key. Required for openai, ignored by ollama and none.
# This is a secret — keep it in .env only.
RAG_LLM_API_KEY=

# Only needed for OpenAI-compatible endpoints that are not OpenAI itself.
# ollama default: http://localhost:11434/v1
RAG_LLM_BASE_URL=

# 0.0 keeps answers closest to the source documents. Raise for more variety.
RAG_LLM_TEMPERATURE=0.0

# Maximum length of a generated answer, in tokens.
RAG_LLM_MAX_TOKENS=1024


# --- HTTP API (Phase 7) ---------------------------------------------------

# Keep this on 127.0.0.1. The API has no authentication yet, so binding it to
# 0.0.0.0 would expose your documents to anyone who can reach this machine.
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
